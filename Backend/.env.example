# Database Settings
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/portfolio

# Cloudflare R2 (S3-Compatible Storage) Settings
CF_R2_ACCESS_KEY_ID=your_r2_access_key_id
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CF_R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
CF_R2_BUCKET_NAME=your_bucket_name
CF_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Cloudflare Stream Settings
CF_STREAM_ACCOUNT_ID=your_cloudflare_account_id
CF_STREAM_API_TOKEN=your_cloudflare_stream_api_token

# Mail Settings
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@domain.com
MAIL_PORT=587
MAIL_SERVER=smtp.office365.com

# Admin Security Settings
SESSION_SECRET=your_super_secret_session_key
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=secure_admin_password

# Uvicorn running configuration
PORT=8000
HOST=0.0.0.0
